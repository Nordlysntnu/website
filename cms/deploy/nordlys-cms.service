[Unit]
Description=Nordlys CMS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nordlys-cms
Group=nordlys-cms
WorkingDirectory=/opt/nordlys/website/cms
Environment=NODE_ENV=production
Environment=CMS_ENV=production
# Dedicated Node 24.22+ in /opt/nordlys/node; the system Node is left alone.
Environment=PATH=/opt/nordlys/node/bin:/usr/bin:/bin
Environment=HOME=/var/cache/nordlys-cms-npm
Environment=npm_config_cache=/var/cache/nordlys-cms-npm
EnvironmentFile=/etc/nordlys-cms.env
ExecStart=/opt/nordlys/node/bin/npm run start
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/nordlys-cms /opt/nordlys/website/cms/.next/cache /var/cache/nordlys-cms-npm

[Install]
WantedBy=multi-user.target
