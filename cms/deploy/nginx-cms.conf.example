# Add to the existing Nginx setup after checking DNS and certificate paths.
# Do not replace the public website's server block.
server {
    listen 80;
    server_name cms.nordlysntnu.no;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name cms.nordlysntnu.no;
    ssl_certificate /etc/letsencrypt/live/cms.nordlysntnu.no/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cms.nordlysntnu.no/privkey.pem;
    # 8 MB image limit plus multipart overhead; Payload still enforces 8 MB.
    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:3010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
        proxy_read_timeout 60s;
    }
}
