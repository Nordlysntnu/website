[Unit]
Description=Nordlys static website publisher
After=network-online.target nordlys-cms.service
Wants=network-online.target

[Service]
Type=simple
User=nordlys-cms
Group=nordlys-cms
WorkingDirectory=/opt/nordlys/website/cms
Environment=NODE_ENV=production
Environment=CMS_ENV=production
EnvironmentFile=/etc/nordlys-cms.env
ExecStart=/usr/bin/npm run publish:worker
Restart=on-failure
RestartSec=15
TimeoutStopSec=45
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/nordlys-cms /var/www/nordlys
# The source checkout and its installed dependencies stay read-only to this service.
# /var/www/nordlys contains only generated public releases and the current symlink.

[Install]
WantedBy=multi-user.target
