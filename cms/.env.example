# npm run setup generates .env.local with a random secret and a local SQLite DB.
CMS_URL=http://127.0.0.1:3010
PAYLOAD_SECRET=replace-with-a-random-secret
DATABASE_URL=file:./.local/cms.db

# Optional local static-build preview (port 4178), separate from the live website.
NORDLYS_PUBLISH_ENABLED=false
NORDLYS_PUBLISH_MODE=preview
NORDLYS_WEBSITE_URL=http://127.0.0.1:4178
