{
  "name": "nordlys-cms",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs && npm run generate && npm run seed && npm run import:legacy",
    "generate": "payload generate:importmap && payload generate:types",
    "seed": "cross-env NODE_ENV=development CMS_SCHEMA_PUSH=true tsx scripts/seed.ts",
    "schema:sync": "cross-env NODE_ENV=development CMS_SCHEMA_PUSH=true tsx scripts/sync-schema.ts",
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3010",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3010",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/workflow.test.ts",
    "test:api": "tsx --test tests/editorial-api.test.ts",
    "test:accounts": "tsx --test tests/accounts-api.test.ts",
    "test:runtime": "tsx --test tests/runtime.test.ts",
    "test:storage": "node --test tests/storage.test.mjs",
    "db:migrate": "payload migrate",
    "db:status": "payload migrate:status",
    "bootstrap:admins": "tsx scripts/bootstrap-admins.ts",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "legacy:keys": "tsx scripts/assign-legacy-keys.ts",
    "import:legacy": "tsx scripts/import-legacy.ts",
    "publish:worker": "tsx scripts/publish-worker.ts",
    "publish:once": "tsx scripts/publish-worker.ts --once",
    "test:publication": "tsx --test tests/publication.test.ts",
    "test:browser": "node scripts/test-browser.mjs",
    "publish:preview": "tsx scripts/publish-preview.ts",
    "publish:rollback": "tsx scripts/publish-rollback.ts",
    "2fa:reset": "tsx scripts/reset-2fa.ts",
    "test:mfa": "tsx --test tests/mfa.test.ts",
    "test:adopt": "tsx --test tests/adoptions.test.ts",
    "vipps:webhook": "tsx scripts/vipps-webhook.ts"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "3.92.1",
    "@payloadcms/email-nodemailer": "^3.92.1",
    "@payloadcms/live-preview-react": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/richtext-lexical": "3.92.1",
    "@payloadcms/ui": "3.92.1",
    "graphql": "16.11.0",
    "next": "16.4.3",
    "payload": "3.92.1",
    "proper-lockfile": "4.1.2",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "4.1.4",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "cross-env": "10.1.0",
    "node": "24.22.1",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=24.22.1"
  },
  "overrides": {
    "dompurify": "3.4.17",
    "happy-dom": "21.0.4"
  }
}
