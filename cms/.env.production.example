# Proposed production settings. Fill in on the VM, never commit real values.
CMS_ENV=production
CMS_URL=https://cms.nordlysntnu.no
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
CMS_DATA_DIR=/var/lib/nordlys-cms
DATABASE_URL=file:/var/lib/nordlys-cms/cms.db
CMS_SCHEMA_PUSH=false

# Until an SMTP relay is approved: manual = no mail is sent; administrators get one-hour setup links
# to pass on privately. Remove this line (or set smtp) once the SMTP settings below are filled in.
CMS_EMAIL_MODE=manual

# Approved SMTP relay; password authentication is optional for IP-authorized relays.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Only used by the offline bootstrap command. Confirm addresses before running.
# CMS_BOOTSTRAP_ADMINS=[{"name":"Can Arif Oraz","email":"CONFIRM_ADDRESS"},{"name":"Tobias Johnsen Skånseng","email":"CONFIRM_ADDRESS"}]

# Enable only after the reviewed VM cutover (see docs/website-publication.md).
NORDLYS_PUBLISH_ENABLED=false
NORDLYS_PUBLISH_MODE=live
NORDLYS_PUBLISH_SOURCE=/opt/nordlys/website
NORDLYS_PUBLISH_RELEASES=/var/www/nordlys/releases
NORDLYS_PUBLISH_ACTIVE=/var/www/nordlys/current
NORDLYS_WEBSITE_URL=https://www.nordlysntnu.no

# Adopt a solar panel (Vipps MobilePay ePayment). Leave VIPPS_ENV empty to keep adoption closed.
# test = apitest.vipps.no with the test sales unit, production = api.vipps.no. Keys: business portal,
# For developers -> Show keys. VIPPS_WEBHOOK_SECRET comes from npm run vipps:webhook.
VIPPS_ENV=
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_SUBSCRIPTION_KEY=
VIPPS_MSN=
VIPPS_WEBHOOK_SECRET=
ADOPT_WEBSITE_URL=https://nordlysntnu.no
